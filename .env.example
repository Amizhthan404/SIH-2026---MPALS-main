# ============================================================
# MPLADS AI Monitoring System - Environment Configuration
# ============================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Configuration
# Supported DB_TYPE values:
# - 'sqlite'   : Zero-config local database (stored in server/db/mplads.sqlite)
# - 'postgres' : PostgreSQL production database
DB_TYPE=sqlite

# SQLite Configuration (Used when DB_TYPE=sqlite)
SQLITE_PATH=./db/mplads.sqlite

# PostgreSQL Configuration (Used when DB_TYPE=postgres)
# Option 1: Full Connection URI
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mplads_db

# Option 2: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=mplads_db
PGUSER=postgres
PGPASSWORD=your_secure_password
PGSSL=false

# CORS Allowed Origins (comma-separated or * for all)
CORS_ORIGIN=*
